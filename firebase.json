{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "docs/**",
      "**/*.txt",
      "**/*.md",
      "**/*.ps1",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "google-wallet-jmx (1).jpg",
      "google-wallet-jmx.jpg.jpg"
    ],
    "rewrites": [
      {
        "source": "/d/**",
        "destination": "/device.html"
      },
      {
        "source": "/c/**",
        "destination": "/card.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
